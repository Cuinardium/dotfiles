[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Santiago Ballerini
	email = santiago.balleri@gmail.com

[core]
    editor = nvim
    pager = "nvim +Man!"

[color]
    ; pager = no
[init]
	defaultBranch = main
[pull]
	rebase = true
[credential]
	helper = /usr/libexec/git-core/git-credential-libsecret
