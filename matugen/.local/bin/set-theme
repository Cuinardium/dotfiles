#!/usr/bin/env bash
# Entry point for the set-theme subproject.
#
# The implementation lives beside matugen's config so it stows as one unit; this
# shim only locates it. Override SET_THEME_HOME to run a working copy.
set -euo pipefail

SET_THEME_HOME="${SET_THEME_HOME:-$HOME/.config/matugen/set-theme}"

if [[ ! -d "$SET_THEME_HOME/settheme" ]]; then
    echo "set-theme: implementation not found at $SET_THEME_HOME" >&2
    echo "           (is the matugen dotfiles package stowed?)" >&2
    exit 1
fi

exec env PYTHONPATH="$SET_THEME_HOME${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m settheme "$@"
